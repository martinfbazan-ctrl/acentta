---
/**
 * Confirmación del pedido.
 * ---------------------------------------------------------------
 * La pantalla más subestimada del comercio electrónico. Es el único
 * momento en que alguien que acaba de gastar plata está mirando con
 * atención, y la mayoría de las tiendas la usan para decir "gracias
 * por su compra" y nada más.
 *
 * Acá responde las tres preguntas que quedan abiertas después de
 * pagar: qué pasa ahora, cuándo llega, y qué hago si me arrepiento.
 * Las tres estaban sin responder y las tres generan el correo de
 * soporte que nadie quiere escribir.
 */
import Base from '@layouts/Base.astro';
import Encabezado from '@componentes/Encabezado.astro';
import Pie from '@componentes/Pie.astro';
import Boton from '@componentes/Boton.astro';
import { datosDeTransferencia } from '@lib/transferencia';

/* Los datos bancarios se leen al construir el sitio, no viajan en la
   respuesta del servidor ni se guardan en el navegador. Son públicos
   —se los das a cualquiera que te compre— pero no hay razón para
   pasearlos por el circuito de pago cuando pueden imprimirse acá. */
const banco = datosDeTransferencia();
---

<Base
  titulo="Pedido confirmado · acentta"
  descripcion="Gracias por tu compra."
  sinIndexar={true}
  sinBotonConsulta={true}
>
  <Encabezado slot="encabezado" />

  <div class="contenedor confirmacion">
    <p class="confirmacion__estado" hidden data-estado-pago></p>

    <div class="confirmacion__sello">
      <svg width="30" height="30" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
        <path d="M6.2 11.4 3.3 8.5l-1.1 1.1 4 4 7.6-7.6-1.1-1.1z" />
      </svg>
    </div>

    <h1 class="t-titular" data-titulo-pedido>Listo, tu pedido está confirmado</h1>

    <!-- El número no es un dato de trámite: es lo único que le queda
         a la persona para reclamar, consultar o cancelar. Se muestra
         grande, con un botón para copiarlo de un toque. Dictarlo por
         teléfono desde una barra de direcciones es una mala tarde. -->
    <div class="confirmacion__numero">
      <span class="confirmacion__numero-rotulo">Número de pedido</span>
      <b class="confirmacion__numero-valor tabular" data-numero-pedido>—</b>
      <button class="confirmacion__copiar" type="button" hidden data-copiar-numero>
        <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="5.5" y="5.5" width="8" height="9" rx="1.5" /><path d="M10.5 5.5v-2a1.5 1.5 0 0 0-1.5-1.5H4a1.5 1.5 0 0 0-1.5 1.5v6A1.5 1.5 0 0 0 4 11h1.5" />
        </svg>
        <span data-copiar-texto>Copiar</span>
      </button>
    </div>

    <p class="t-texto" data-mensaje-pedido>
      Guarda ese número: con él puedes consultar el estado del envío en cualquier momento.
    </p>

    <!-- Cómo transferir.
         Se imprime siempre que haya datos bancarios cargados y el
         guion la muestra sólo si el pedido se pagó así. Va ARRIBA de
         «qué pasa ahora» a propósito: mientras no entre la plata no
         pasa nada, y lo primero que la persona necesita es a dónde
         mandarla. -->
    {banco && (
      <div class="confirmacion__caja transferir" data-transferir hidden>
        <h2 class="confirmacion__subtitulo">Cómo completar el pago</h2>
        <p class="t-texto">
          Transferí el total a esta cuenta. <b>Poné tu número de pedido en el concepto</b>:
          es con lo que reconocemos tu depósito.
        </p>
        <dl class="transferir__datos">
          <div><dt>Alias</dt><dd class="tabular" data-copiar={banco.alias}>{banco.alias}</dd></div>
          <div><dt>CBU</dt><dd class="tabular" data-copiar={banco.cbu}>{banco.cbu}</dd></div>
          <div><dt>Titular</dt><dd>{banco.titular}</dd></div>
          {banco.cuit && <div><dt>CUIT</dt><dd class="tabular">{banco.cuit}</dd></div>}
          {banco.banco && <div><dt>Banco</dt><dd>{banco.banco}</dd></div>}
          <div><dt>Concepto</dt><dd class="tabular" data-transferir-numero>—</dd></div>
        </dl>
        <p class="transferir__nota">
          Tenés 48 horas para transferir. Después revisamos el banco y te confirmamos
          por correo; recién ahí preparamos el pedido.
        </p>
      </div>
    )}

    <div class="confirmacion__caja">
      <h2 class="confirmacion__subtitulo">Qué pasa ahora</h2>
      <!-- [ERROR CORREGIDO] El texto de cada paso quedaba partido en
           dos columnas angostas: «Preparamos el / pedido.» a la
           izquierda y el resto a la derecha.

           La causa no era el ancho de la página. El `li` es un
           contenedor flex —para poner el número en un círculo al
           costado— y en un contenedor flex **cada nodo de texto suelto
           se convierte en un elemento más**. Así, el `<b>` era un hijo
           y la frase que le sigue era otro, y cada uno se medía por su
           cuenta como si fueran dos columnas.

           Con el contenido envuelto en un `<span>`, el flex ve dos
           hijos —el número y el párrafo— y el texto vuelve a fluir
           como un texto. -->
      <ol class="pasos-siguientes">
        <li><span><b>Preparamos el pedido.</b> Entre hoy y mañana lo empaquetamos en el depósito.</span></li>
        <li><span><b>Sale y te avisamos.</b> Cuando lo despachamos te llega el número de seguimiento por correo.</span></li>
        <li><span><b>Llega a tu casa</b><span data-fecha-entrega></span>. Si no hay nadie, el correo deja aviso y reintenta al día siguiente.</span></li>
      </ol>
    </div>

    <div class="confirmacion__resumen" data-resumen-pedido hidden>
      <h2 class="confirmacion__subtitulo">Tu pedido</h2>
      <div class="confirmacion__items" data-items-pedido></div>
      <dl class="confirmacion__cuentas">
        <div><dt>Envío</dt><dd class="tabular" data-envio-pedido>—</dd></div>
        <div class="es-total"><dt>Total pagado</dt><dd class="tabular" data-total-pedido>—</dd></div>
      </dl>
    </div>

    <div class="confirmacion__acciones">
      <Boton href="/seguimiento" tamano="grande">Seguir mi pedido</Boton>
      <Boton href="/ofertas" jerarquia="secundario" tamano="grande">Seguir mirando</Boton>
    </div>

    <p class="confirmacion__arrepentimiento">
      ¿Te arrepentiste? Tienes 10 días corridos para cancelar sin dar explicaciones,
      con el <a href="/arrepentimiento">botón de arrepentimiento</a>. Y 30 días para
      devolverlo si ya llegó y no te convence.
    </p>

    <!-- Este aviso desaparece cuando el pedido es de verdad.
         Dejarlo fijo sería mentir en la dirección peligrosa: alguien
         que acaba de pagar leyendo que no se procesó ningún pago
         tiene motivos para asustarse, y razón para desconfiar de
         todo lo demás que diga la página. Lo apaga el guion apenas
         confirma que hay un pedido registrado en el servidor. -->
    <p class="confirmacion__aviso" data-aviso-demostracion>
      acentta es un proyecto conceptual de portafolio. No se procesó ningún pago
      real ni se guardó ningún dato personal.
    </p>
  </div>

  <Pie slot="pie" />
</Base>

<script>
  import '../scripts/confirmacion';
</script>

<style>
  .confirmacion {
    /* 68ch era el ancho de una columna de lectura, y está bien para
       texto corrido. Pero esta página dejó de ser texto: tiene una
       tabla de datos bancarios, una lista numerada y un resumen con
       precios alineados a la derecha. Todo eso en 68ch se amontona.

       Mismo valor que /mis-pedidos, y es a propósito: son las dos
       pantallas donde alguien vuelve a mirar su compra, y que cambien
       de ancho entre una y otra se nota. */
    max-width: 84ch;
    padding-block: var(--e-16) var(--e-24);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--e-4);
  }
  .confirmacion__sello {
    width: 60px; height: 60px;
    display: grid; place-items: center;
    background: var(--verde-wash);
    color: var(--verde);
    border-radius: 50%;
    margin-bottom: var(--e-2);
  }
  .confirmacion__numero {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--e-2) var(--e-3);
    margin-block: var(--e-4);
    padding: var(--e-4);
    background: var(--gris-050);
    border: 1px solid var(--gris-200);
    border-radius: var(--r-tarjeta);
  }
  .confirmacion__numero-rotulo {
    font-size: var(--t-meta); color: var(--gris-texto);
    text-transform: uppercase; letter-spacing: .07em; font-weight: 700;
    flex-basis: 100%;
  }
  .confirmacion__numero-valor {
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.5rem);
    font-weight: 700; letter-spacing: .02em; color: var(--tinta);
    /* Un número que se dicta por teléfono no puede partirse al medio. */
    white-space: nowrap;
  }
  .confirmacion__copiar {
    display: inline-flex; align-items: center; gap: var(--e-2);
    min-height: 36px; padding-inline: var(--e-3);
    background: var(--papel);
    border: 1px solid var(--gris-200);
    border-radius: var(--r-pastilla);
    font-size: var(--t-meta); color: var(--gris-800);
    cursor: pointer;
  }
  .confirmacion__copiar:hover { border-color: var(--gris-500); color: var(--tinta); }

  /* Estado del pago. El aprobado no lleva color: ya lo dice el sello
     verde de arriba, y repetirlo le quita fuerza al que sí importa. */
  .confirmacion__estado {
    display: inline-block;
    margin-bottom: var(--e-3);
    padding: var(--e-2) var(--e-3);
    border-radius: var(--r-pastilla);
    font-size: var(--t-meta); font-weight: 600;
  }
  .confirmacion__estado[data-estado='pendiente'] { background: var(--oferta-wash); color: var(--naranja-texto-oliva); }
  .confirmacion__estado[data-estado='rechazado'],
  .confirmacion__estado[data-estado='cancelado'] { background: var(--rojo-wash, #FBE9E7); color: var(--rojo); }

  .confirmacion__caja {
    width: 100%;
    padding: var(--e-6);
    background: var(--papel);
    border: 1px solid var(--gris-200);
    border-radius: var(--r-modal);
    margin-top: var(--e-4);
  }
  .confirmacion__subtitulo { font-size: 1rem; font-weight: 700; margin-bottom: var(--e-4); }

  /* La caja de transferencia se distingue del resto: es lo único de
     esta página que pide una acción. Todo lo demás es información. */
  .transferir { border-color: var(--tinta); border-width: 2px; }
  .transferir__datos {
    display: grid; gap: var(--e-2);
    margin-top: var(--e-4);
  }
  .transferir__datos > div {
    /* `minmax(0, 1fr)` y no `1fr`: un CBU son 22 dígitos seguidos sin
       espacios, y una columna `auto` no se achica por debajo de su
       contenido. En un teléfono angosto eso corta la caja. */
    display: grid; grid-template-columns: 90px minmax(0, 1fr); gap: var(--e-3);
    align-items: baseline;
  }
  .transferir__datos dt { font-size: var(--t-meta); color: var(--gris-texto); }
  .transferir__datos dd { font-weight: 600; overflow-wrap: anywhere; }
  .transferir__nota {
    margin-top: var(--e-4);
    font-size: var(--t-meta); color: var(--gris-texto); line-height: 1.5;
  }
  .pasos-siguientes { display: flex; flex-direction: column; gap: var(--e-3); counter-reset: p; }
  .pasos-siguientes li {
    display: flex; gap: var(--e-3);
    font-size: 0.9375rem; line-height: 1.55; color: var(--gris-800);
    counter-increment: p;
  }
  /* El párrafo ocupa lo que sobra. `minmax` no aplica en flex, así que
     el equivalente es `min-width: 0`: sin eso, un hijo de flex no se
     achica por debajo de su contenido más ancho. Es el mismo cuidado
     que las grillas del carrito. */
  .pasos-siguientes li > span { flex: 1; min-width: 0; }
  .pasos-siguientes li::before {
    content: counter(p);
    flex: none;
    width: 24px; height: 24px;
    display: grid; place-items: center;
    background: var(--arena-honda);
    border-radius: 50%;
    font-size: 12px; font-weight: 700; color: var(--tinta);
  }
  .pasos-siguientes b { color: var(--tinta); }

  .confirmacion__resumen {
    width: 100%;
    margin-top: var(--e-4);
    padding: var(--e-6);
    background: var(--papel);
    border: 1px solid var(--gris-200);
    border-radius: var(--r-modal);
  }
  .confirmacion__items { display: flex; flex-direction: column; }
  .confirmacion__cuentas {
    margin-top: var(--e-4);
    padding-top: var(--e-4);
    border-top: 1px solid var(--gris-200);
    display: flex;
    flex-direction: column;
    gap: var(--e-2);
  }
  .confirmacion__cuentas > div { display: flex; justify-content: space-between; gap: var(--e-4); font-size: 0.9375rem; }
  .confirmacion__cuentas dt { color: var(--gris-800); }
  .confirmacion__cuentas dd { margin: 0; font-weight: 600; }
  .confirmacion__cuentas .es-total { font-size: 1.0625rem; padding-top: var(--e-2); }
  .confirmacion__cuentas .es-total dt { color: var(--tinta); font-weight: 600; }
  .confirmacion__cuentas .es-total dd { font-size: var(--t-precio); font-weight: 700; }

  :global(.cf-item) {
    display: flex;
    gap: var(--e-3);
    align-items: center;
    padding: var(--e-3) 0;
    border-bottom: 1px solid var(--gris-200);
  }
  :global(.cf-item:last-child) { border-bottom: 0; }
  :global(.cf-item__foto) {
    width: 52px; height: 52px; flex: none;
    object-fit: cover; border-radius: var(--r-badge);
    background: var(--gris-050);
  }
  :global(.cf-item__datos) { flex: 1; min-width: 0; }
  :global(.cf-item__nombre) { font-size: 0.875rem; font-weight: 500; line-height: 1.35; }
  :global(.cf-item__meta) { font-size: var(--t-meta); color: var(--gris-texto); }
  :global(.cf-item__precio) { font-size: 0.9375rem; font-weight: 700; font-variant-numeric: tabular-nums; }

  .confirmacion__acciones { display: flex; flex-wrap: wrap; gap: var(--e-3); margin-top: var(--e-4); }

  .confirmacion__arrepentimiento {
    font-size: 0.875rem; color: var(--gris-800); line-height: 1.6;
    padding-top: var(--e-6); margin-top: var(--e-4);
    border-top: 1px solid var(--gris-200);
  }
  .confirmacion__arrepentimiento a { color: var(--naranja-texto); font-weight: 600; }
  .confirmacion__aviso { font-size: var(--t-meta); color: var(--gris-texto); }
</style>
