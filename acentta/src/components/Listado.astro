---
/**
 * Listado de productos (PLP).
 * ---------------------------------------------------------------
 * Lo usan la página de categoría, la de ofertas y la de más vendidos.
 * Los tres listados son el mismo componente con otro conjunto de
 * datos — si mañana hay que arreglar el orden o el estado vacío, se
 * arregla en un solo lugar.
 *
 * El HTML llega con todos los productos y el filtrado ocurre en el
 * navegador. Es una decisión deliberada: el buscador indexa el
 * listado completo, y filtrar no cuesta un viaje a la red. Con 36
 * productos esto es correcto; a partir de unos cientos habría que
 * mover el filtro al servidor.
 */
import TarjetaProducto from '@componentes/TarjetaProducto.astro';
import PanelFiltros from '@componentes/PanelFiltros.astro';
import Boton from '@componentes/Boton.astro';
import Migas from '@componentes/Migas.astro';
import { coloresDe, rangoDePrecios, conteoPorCategoria } from '@lib/catalogo';
import type { Producto, Categoria } from '@tipos/catalogo';

interface Props {
  titulo: string;
  descripcion: string;
  productos: Producto[];
  migas: { nombre: string; href?: string }[];
  sinCategoria?: boolean;
}

const { titulo, descripcion, productos, migas, sinCategoria = false } = Astro.props;

const colores = coloresDe(productos);
const rango = rangoDePrecios(productos);
const conteo = conteoPorCategoria(productos);
const categorias = [...conteo.entries()].map(([clave, cantidad]) => ({
  clave: clave as Categoria,
  cantidad,
}));
---

<div class="contenedor listado" data-listado>
  <Migas pasos={migas} class="listado__migas" />

  <header class="listado__cabeza">
    <h1 class="t-titular">{titulo}</h1>
    <p class="t-texto listado__bajada">{descripcion}</p>
  </header>

  <div class="listado__cuerpo">
    <PanelFiltros
      colores={colores}
      categorias={categorias}
      rango={rango}
      total={productos.length}
      sinCategoria={sinCategoria}
    />

    <div class="listado__principal">
      <!-- Barra de control: cuenta, orden y acceso a filtros en móvil -->
      <div class="control">
        <p class="control__cuenta" aria-live="polite">
          <b class="tabular" data-cuenta>{productos.length}</b>
          <span data-cuenta-palabra>{productos.length === 1 ? 'producto' : 'productos'}</span>
        </p>

        <div class="control__acciones">
          <button class="control__filtros boton boton--secundario boton--chico" type="button" data-abrir-filtros>
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M2 4h12M4 8h8M6.5 12h3" stroke-linecap="round" />
            </svg>
            <span class="boton__texto">Filtrar</span>
            <span class="control__globo tabular" data-cuenta-filtros hidden>0</span>
          </button>

          <label class="orden">
            <span class="vo">Ordenar por</span>
            <select class="orden__campo" data-orden>
              <option value="relevancia">Más relevantes</option>
              <option value="precio-asc">Precio: de menor a mayor</option>
              <option value="precio-desc">Precio: de mayor a menor</option>
              <option value="vendidas">Más vendidos</option>
              <option value="rating">Mejor calificados</option>
              <option value="descuento">Mayor descuento</option>
            </select>
            <svg class="orden__flecha" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M3 4.5 6 7.5l3-3" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </label>
        </div>
      </div>

      <!-- Chips de filtro activo -->
      <div class="activos" data-chips hidden>
        <span class="activos__rotulo">Filtrando por:</span>
        <div class="activos__lista" data-chips-lista></div>
        <button class="chip chip--limpiar" type="button" data-limpiar-filtros>Limpiar todo</button>
      </div>

      <!-- Sólo las dos primeras piden prioridad de carga. Con cuatro,
           el navegador reparte el mismo ancho de banda entre las cuatro
           y ninguna llega antes: pedir prioridad para todo es lo mismo
           que no pedirla para nada, y encima le quita turno al CSS.
           Dos es lo que se ve sin bajar en un teléfono. -->
      <div class="grilla-productos" data-grilla>
        {productos.map((p, i) => (
          <TarjetaProducto producto={p} prioritaria={i < 2} filtrable />
        ))}
      </div>

      <!-- Estado vacío · nunca un callejón sin salida -->
      <div class="vacio" data-vacio hidden>
        <svg class="vacio__icono" width="44" height="44" viewBox="0 0 44 44" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="19" cy="19" r="12" /><path d="M28 28l8 8" stroke-linecap="round" />
        </svg>
        <div>
          <p class="vacio__titulo">Ningún producto cumple con todo eso</p>
          <p class="vacio__texto t-meta" style="margin-top:8px">
            Suele pasar cuando se combinan un tramo de precio y un color.
            Prueba soltando el filtro más restrictivo.
          </p>
        </div>
        <div class="vacio__acciones">
          <Boton jerarquia="secundario" data-limpiar-filtros>Quitar todos los filtros</Boton>
          <Boton href="/ofertas">Ver lo que está en oferta</Boton>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Fondo del panel de filtros en móvil -->
<div class="velo" data-velo hidden></div>

<style>
  .listado { padding-block: var(--e-6) var(--e-16); }
  .listado__migas { margin-bottom: var(--e-6); }
  .listado__cabeza { margin-bottom: var(--e-8); }
  .listado__bajada { margin-top: var(--e-3); }

  .listado__cuerpo { display: grid; gap: var(--e-8); }
  @media (min-width: 900px) {
    .listado__cuerpo { grid-template-columns: 268px minmax(0, 1fr); align-items: start; }
    .listado__cuerpo > .filtros { position: sticky; top: calc(var(--e-24) + var(--e-2)); max-height: calc(100vh - var(--e-24) - var(--e-6)); }
  }

  .listado__principal { min-width: 0; }

  /* ---- Barra de control ---- */
  .control {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-4);
    padding-bottom: var(--e-4);
    margin-bottom: var(--e-4);
    border-bottom: 1px solid var(--gris-200);
  }
  .control__cuenta { font-size: 0.9375rem; color: var(--gris-800); }
  .control__cuenta b { color: var(--tinta); }
  .control__acciones { display: flex; align-items: center; gap: var(--e-3); }

  .control__filtros { position: relative; }
  @media (min-width: 900px) { .control__filtros { display: none; } }
  .control__globo {
    min-width: 18px; height: 18px;
    padding-inline: 5px;
    display: grid; place-items: center;
    background: var(--naranja-accion);
    color: var(--blanco);
    font-size: 11px; font-weight: 700;
    border-radius: 999px;
  }

  .orden { position: relative; display: inline-flex; align-items: center; }
  .orden__campo {
    appearance: none;
    height: 36px;
    padding: 0 var(--e-8) 0 var(--e-3);
    border: 1px solid var(--gris-500);
    border-radius: var(--r-tarjeta);
    background: var(--papel);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
  }
  .orden__campo:hover { border-color: var(--tinta); }
  .orden__campo:focus {
    outline: none;
    border-color: var(--verde);
    box-shadow: 0 0 0 1px var(--verde), 0 0 0 4px rgba(47, 93, 58, .16);
  }
  .orden__flecha { position: absolute; right: var(--e-3); pointer-events: none; color: var(--gris-texto); }

  /* ---- Chips activos ---- */
  .activos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-2);
    margin-bottom: var(--e-5);
  }
  .activos__rotulo { font-size: var(--t-meta); color: var(--gris-texto); }
  .activos__lista { display: flex; flex-wrap: wrap; gap: var(--e-2); }

  /* ---- Transición al filtrar ----
     No hay skeleton: los datos ya están en la página y fingir una
     espera sería teatro. Un cruce de 120 ms alcanza para que el
     cambio se perciba sin que parezca un salto. */
  [data-grilla] { transition: opacity var(--v-rapido) var(--curva); }
  [data-grilla][data-filtrando='true'] { opacity: .35; }

  .velo {
    position: fixed;
    inset: 0;
    z-index: 55;
    background: rgba(28, 24, 20, .5);
    backdrop-filter: blur(2px);
  }
  @media (min-width: 900px) { .velo { display: none; } }
</style>
