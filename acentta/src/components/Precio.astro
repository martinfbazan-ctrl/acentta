---
/**
 * Bloque de precio · anclaje, ahorro y cuotas (brief §3.2).
 * El ahorro en pesos va antes que el porcentaje: en ticket medio el
 * monto pesa más que el porcentaje.
 */
import {
  precio as fPrecio, cuota,
  precioSinImpuestos, MOSTRAR_PRECIO_SIN_IMPUESTOS, IVA_GENERAL,
} from '@lib/formato';

interface Props {
  precio: number;
  precioAnterior?: number;
  /** Cantidad de cuotas sin interés. 0 desactiva la línea. */
  cuotas?: number;
  /** Para productos de conjunto: "$ 3.400 por unidad". */
  unidades?: number;
  /** Alícuota de IVA del producto. La general es 21 %. */
  iva?: number;
  tamano?: 'tarjeta' | 'ficha';
  class?: string;
}

const {
  precio: valor,
  precioAnterior,
  cuotas = 6,
  unidades,
  iva = IVA_GENERAL,
  tamano = 'tarjeta',
  class: clase,
} = Astro.props;

/* El renglón de transparencia fiscal, sólo en la ficha.
 *
 * En la tarjeta de la grilla no va: ahí compiten veinte precios y un
 * segundo número debajo de cada uno convierte la grilla en una
 * planilla. La obligación —cuando aplica— es informarlo donde se
 * decide la compra, y eso es la ficha.
 */
const conNeto = MOSTRAR_PRECIO_SIN_IMPUESTOS && tamano === 'ficha' && valor > 0;
const neto = conNeto ? precioSinImpuestos(valor, iva) : 0;

const hayDescuento = precioAnterior !== undefined && precioAnterior > valor;
const ahorro = hayDescuento ? precioAnterior - valor : 0;
const porcentaje = hayDescuento ? Math.round((ahorro / precioAnterior) * 100) : 0;
const clases = ['precio', tamano === 'ficha' && 'precio--ficha', clase].filter(Boolean).join(' ');
---

<div class={clases}>
  <div class="precio__fila">
    <span class="precio__actual">{fPrecio(valor)}</span>
    {hayDescuento && (
      <s class="precio__anterior">
        <span class="vo">Precio anterior: </span>{fPrecio(precioAnterior)}
      </s>
    )}
  </div>

  {hayDescuento && (
    <p class="precio__ahorro">Ahorras {fPrecio(ahorro)} ({porcentaje} %)</p>
  )}

  {cuotas > 0 && (
    <p class="precio__cuotas">
      {cuotas} cuotas sin interés de <b>{cuota(valor, cuotas)}</b>
    </p>
  )}

  {unidades && unidades > 1 && (
    <p class="precio__unitario">{fPrecio(Math.round(valor / unidades))} por unidad</p>
  )}

  {conNeto && (
    /* Chico y gris a propósito: es un dato de cumplimiento, no un
       argumento de venta. Puesto con el mismo peso que el precio
       compite con él y confunde sobre cuánto se paga. */
    <p class="precio__neto">Precio sin impuestos nacionales: {fPrecio(neto)}</p>
  )}
</div>
