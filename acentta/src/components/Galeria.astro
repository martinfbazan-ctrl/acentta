---
/**
 * Galería de la ficha.
 * La foto grande cambia sin recargar ni saltar: el contenedor tiene
 * proporción fija, así que el alto no se mueve cuando cambia la imagen.
 * Con una sola foto, las miniaturas desaparecen en vez de mostrar una
 * fila de una — ese es el fallback del caso borde del brief.
 */
import { foto, srcset } from '@lib/imagenes';
import type { Imagen } from '@tipos/catalogo';

interface Props {
  imagenes: Imagen[];
  nombre: string;
}
const { imagenes, nombre } = Astro.props;
const unaSola = imagenes.length === 1;
---

<div class="galeria" data-galeria>
  <div class="galeria__marco">
    <img
      class="galeria__foto"
      data-galeria-principal
      src={foto(imagenes[0]!.src, 1000)}
      srcset={srcset(imagenes[0]!.src)}
      sizes="(min-width: 900px) 620px, 100vw"
      alt={imagenes[0]!.alt}
      width="1000"
      height="1250"
      fetchpriority="high"
      decoding="async"
    />
    <button class="galeria__lupa" type="button" data-abrir-zoom aria-label={`Ver ${nombre} en tamaño grande`}>
      <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
        <circle cx="8.5" cy="8.5" r="6" /><path d="M13 13l4.5 4.5M6 8.5h5M8.5 6v5" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  {!unaSola && (
    <ul class="galeria__tiras" role="list">
      {imagenes.map((img, i) => (
        <li>
          <button
            class="galeria__tira"
            type="button"
            data-indice={i}
            data-src={img.src}
            data-alt={img.alt}
            aria-label={`Ver foto ${i + 1} de ${imagenes.length}`}
            aria-current={i === 0 ? 'true' : undefined}
          >
            <img src={foto(img.src, 200)} alt="" width="100" height="100" loading="lazy" decoding="async" />
          </button>
        </li>
      ))}
    </ul>
  )}
</div>

<!-- Zoom · se abre sobre la página, se cierra con Escape o clic afuera -->
<dialog class="zoom" data-zoom aria-label={`${nombre}, foto ampliada`}>
  <button class="zoom__cerrar" type="button" data-cerrar-zoom aria-label="Cerrar">
    <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
      <path d="M5 5l10 10M15 5L5 15" stroke-linecap="round" />
    </svg>
  </button>
  {/* Las flechas sólo tienen sentido con más de una foto. Con una
      sola serían dos botones que no hacen nada, y un lector de
      pantalla los anunciaría igual. */}
  {imagenes.length > 1 && (
    <>
      <button class="zoom__paso zoom__paso--antes" type="button" data-zoom-antes aria-label="Foto anterior">
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <button class="zoom__paso zoom__paso--despues" type="button" data-zoom-despues aria-label="Foto siguiente">
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </>
  )}

  <!-- Sin src: un src vacío hace que algunos navegadores pidan la
       propia página como si fuera una imagen. La fuente y el texto
       alternativo los pone el guion al abrir el zoom. -->
  <img class="zoom__foto" data-zoom-foto alt="" />

  {imagenes.length > 1 && (
    /* «2 de 4». Sin esto no hay forma de saber cuántas faltan, y la
       flecha parece que no hace nada cuando la foto siguiente se
       parece a la anterior — que con fotos de producto pasa siempre.
       `aria-live` lo anuncia al cambiar, para quien no ve la foto. */
    <p class="zoom__cuenta tabular" data-zoom-cuenta aria-live="polite"></p>
  )}
</dialog>

<style>
  .galeria { display: flex; flex-direction: column; gap: var(--e-3); }

  .galeria__marco {
    position: relative;
    border-radius: var(--r-modal);
    overflow: hidden;
    /* Blanco y no gris: con `contain` el fondo del marco queda a la
       vista alrededor de la foto, y casi todas las fotos de producto
       vienen recortadas sobre blanco. Un gris claro detrás dibuja un
       recuadro alrededor del producto que no está en la foto.

       `--papel` y no `--blanco`: los dos son #FFFFFF, pero el primero
       es el token de superficie y el segundo es para texto sobre
       color. El día que las superficies dejen de ser blancas puras,
       el que hay que cambiar es uno solo. */
    background: var(--papel);
    border: 1px solid var(--gris-200);
  }
  .galeria__foto {
    width: 100%;
    aspect-ratio: var(--proporcion-producto);
    /* `contain` y no `cover`.
     *
     * [ERROR CORREGIDO] Con `cover` la foto se agranda hasta llenar el
     * marco y lo que sobra se recorta. Eso era correcto cuando el
     * catálogo eran fotos de ambiente: recortar un living no le saca
     * nada al living. Con fotos de producto le corta la tapa al termo.
     *
     * Y no se arregla pidiendo fotos cuadradas: las de una misma marca
     * ya vienen en cuatro tamaños distintos —800×950, 1200×1200,
     * 1515×1515— y esperar que quien carga productos las uniforme
     * antes de subirlas es delegarle un trabajo que el navegador hace
     * gratis. Con `contain` entra entera venga como venga. */
    object-fit: contain;
    display: block;
  }

  /* Antes acá había una excepción para móvil: la foto pasaba de 4/5 a
     cuadrada porque a todo el ancho daba más de 440 px de alto y
     empujaba el precio debajo del pliegue, en la pantalla donde se
     decide la compra.

     Esa excepción ya no hace falta: al pasar todo el sitio a fotos
     cuadradas, el móvil quedó como estaba y el escritorio ganó lo
     mismo. Lo que sí se mantiene es achicar las miniaturas, que es
     de donde salen los últimos píxeles. */
  @media (max-width: 899px) {
    .galeria { gap: var(--e-2); }
    .galeria__tira { width: 52px; }
  }

  .galeria__lupa {
    position: absolute;
    right: var(--e-3);
    bottom: var(--e-3);
    width: 44px; height: 44px;
    display: grid; place-items: center;
    background: var(--papel);
    color: var(--tinta);
    border: 1px solid var(--gris-200);
    border-radius: var(--r-tarjeta);
    cursor: pointer;
    box-shadow: var(--sombra-1);
  }
  .galeria__lupa:hover { background: var(--arena); }

  .galeria__tiras {
    display: flex;
    gap: var(--e-2);
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 2px;
  }
  .galeria__tiras::-webkit-scrollbar { display: none; }

  .galeria__tira {
    flex: none;
    width: 74px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: var(--r-tarjeta);
    overflow: hidden;
    background: var(--papel);
    cursor: pointer;
    transition: border-color var(--v-rapido) var(--curva);
  }
  .galeria__tira img { width: 100%; aspect-ratio: var(--proporcion-producto); object-fit: contain; display: block; }
  .galeria__tira:hover { border-color: var(--gris-500); }
  .galeria__tira[aria-current='true'] { border-color: var(--tinta); }

  /* ---- Zoom ---- */
  .zoom {
    border: 0;
    padding: 0;
    max-width: min(96vw, 1000px);
    max-height: 94vh;
    background: var(--papel);
    border-radius: var(--r-modal);
    box-shadow: var(--sombra-2);
    overflow: hidden;
  }
  .zoom::backdrop { background: rgba(28, 24, 20, .78); backdrop-filter: blur(3px); }
  .zoom__foto { display: block; width: 100%; height: auto; max-height: 94vh; object-fit: contain; }

  /* Las flechas van sobre la foto, centradas verticalmente y pegadas
     a cada borde. Fondo propio y no transparentes: una flecha blanca
     sobre una foto de producto blanca desaparece, y con fotos de
     catálogo el fondo blanco es la regla y no la excepción. */
  .zoom__paso {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    /* 44 px es el mínimo táctil. No es un número de diseño: es lo que
       mide la yema de un pulgar y lo que pide la norma. */
    width: 44px; height: 44px;
    display: grid; place-items: center;
    background: var(--papel);
    border: 1px solid var(--gris-200);
    border-radius: 50%;
    color: var(--tinta);
    cursor: pointer;
    z-index: 1;
    box-shadow: var(--sombra-1);
  }
  .zoom__paso--antes { left: var(--e-3); }
  .zoom__paso--despues { right: var(--e-3); }
  .zoom__paso:hover { background: var(--gris-050); }

  .zoom__cuenta {
    position: absolute;
    bottom: var(--e-3);
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    padding: var(--e-1) var(--e-3);
    background: var(--papel);
    border: 1px solid var(--gris-200);
    border-radius: var(--r-badge);
    font-size: 0.8125rem;
    /* --gris-800 y no un gris más claro: 9,3:1 contra el fondo. Es
       texto chico sobre un panel claro y tiene que leerse. */
    color: var(--gris-800);
  }

  /* En móvil el botón de cerrar y la flecha derecha se pisan: la
     flecha baja para dejarle el ángulo libre. */
  @media (max-width: 599px) {
    .zoom__paso { width: 40px; height: 40px; }
    .zoom__paso--antes { left: var(--e-2); }
    .zoom__paso--despues { right: var(--e-2); }
  }
  .zoom__cerrar {
    position: absolute;
    top: var(--e-3); right: var(--e-3);
    width: 44px; height: 44px;
    display: grid; place-items: center;
    background: var(--papel);
    border: 1px solid var(--gris-200);
    border-radius: var(--r-tarjeta);
    color: var(--tinta);
    cursor: pointer;
    z-index: 1;
  }
</style>
