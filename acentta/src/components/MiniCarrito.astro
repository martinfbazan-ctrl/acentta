---
/**
 * Mini-carrito lateral.
 * ---------------------------------------------------------------
 * Se abre al agregar, sin modal que interrumpa: quien está mirando
 * la grilla puede seguir mirando la grilla. Trae la barra de envío
 * gratis porque este es el momento exacto en que sumar un producto
 * más tiene sentido — el carrito acaba de cambiar y el umbral está
 * más cerca que hace un segundo.
 */
import { precio } from '@lib/formato';
import { UMBRAL_ENVIO_GRATIS } from '@tipos/catalogo';
---

<div class="velo-carrito" data-velo-carrito hidden></div>

<aside
  class="mini"
  id="mini-carrito"
  data-mini
  aria-labelledby="tit-mini"
  aria-hidden="true"
>
  <header class="mini__cabeza">
    <h2 class="mini__titulo" id="tit-mini">
      Tu carrito <span class="mini__cuenta tabular" data-mini-cuenta>0</span>
    </h2>
    <button class="mini__cerrar" type="button" data-cerrar-mini aria-label="Cerrar el carrito">
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M5 5l10 10M15 5L5 15" stroke-linecap="round" />
      </svg>
    </button>
  </header>

  <div class="mini__envio" data-mini-envio>
    <div class="envio-gratis" data-logrado="false">
      <p class="envio-gratis__texto" data-mini-envio-texto>
        Te faltan <b>{precio(UMBRAL_ENVIO_GRATIS)}</b> para el envío gratis
      </p>
      <div class="envio-gratis__via" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" aria-label="Progreso hacia el envío gratis" data-mini-barra>
        <div class="envio-gratis__relleno" style="--progreso:0%"></div>
      </div>
    </div>
  </div>

  <div class="mini__cuerpo" data-mini-lista></div>

  <div class="mini__vacio" data-mini-vacio>
    <svg width="40" height="40" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4">
      <path d="M3 4h2l2.2 11a1.8 1.8 0 0 0 1.8 1.4h8a1.8 1.8 0 0 0 1.8-1.4L21 7H6" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="10" cy="20" r="1.3" fill="currentColor" stroke="none" />
      <circle cx="17" cy="20" r="1.3" fill="currentColor" stroke="none" />
    </svg>
    <p class="mini__vacio-titulo">Todavía no agregaste nada</p>
    <p class="t-meta">Cuando agregues algo va a aparecer acá, y se queda aunque cierres la página.</p>
    <a class="boton boton--secundario" href="/ofertas"><span class="boton__texto">Ver ofertas</span></a>
  </div>

  <footer class="mini__pie" data-mini-pie hidden>
    <div class="mini__linea">
      <span>Subtotal</span>
      <b class="tabular" data-mini-subtotal>$ 0</b>
    </div>
    <p class="mini__nota" data-mini-nota>El envío se calcula en el carrito, antes de pagar.</p>
    <a class="boton boton--primario boton--grande boton--ancho" href="/carrito">
      <span class="boton__texto">Ir al carrito</span>
    </a>
    <button class="boton boton--fantasma boton--ancho" type="button" data-cerrar-mini>
      <span class="boton__texto">Seguir comprando</span>
    </button>
  </footer>
</aside>

<style>
  .velo-carrito {
    position: fixed;
    inset: 0;
    z-index: 70;
    background: rgba(28, 24, 20, .45);
    backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity var(--v-medio) var(--curva);
  }
  .velo-carrito[data-visible='true'] { opacity: 1; }

  .mini {
    position: fixed;
    top: 0; right: 0; bottom: 0;
    z-index: 75;
    width: min(420px, 100vw);
    display: flex;
    flex-direction: column;
    background: var(--papel);
    box-shadow: var(--sombra-2);
    transform: translateX(100%);
    visibility: hidden;
    transition: transform var(--v-medio) var(--curva), visibility var(--v-medio);
  }
  .mini[data-abierto='true'] { transform: translateX(0); visibility: visible; }

  .mini__cabeza {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--e-4) var(--e-5);
    border-bottom: 1px solid var(--gris-200);
  }
  .mini__titulo { font-size: 1.0625rem; font-weight: 700; display: flex; align-items: center; gap: var(--e-2); }
  .mini__cuenta {
    min-width: 22px; height: 22px;
    padding-inline: 6px;
    display: grid; place-items: center;
    background: var(--tinta);
    color: var(--papel);
    font-size: 12px;
    border-radius: 999px;
  }
  .mini__cerrar {
    width: 44px; height: 44px;
    display: grid; place-items: center;
    background: none; border: 0; cursor: pointer;
    color: var(--tinta);
    border-radius: var(--r-tarjeta);
  }
  .mini__cerrar:hover { background: var(--gris-050); }

  .mini__envio { padding: var(--e-4) var(--e-5); border-bottom: 1px solid var(--gris-200); }

  .mini__cuerpo { flex: 1; overflow-y: auto; padding: var(--e-4) var(--e-5); }

  .mini__vacio {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--e-3);
    padding: var(--e-8) var(--e-6);
    text-align: center;
  }
  .mini__vacio svg { color: var(--gris-500); }
  .mini__vacio-titulo { font-weight: 600; }
  .mini__vacio .t-meta { max-width: 34ch; }
  .mini__vacio .boton { margin-top: var(--e-3); }

  .mini__pie {
    padding: var(--e-4) var(--e-5);
    padding-bottom: max(var(--e-4), env(safe-area-inset-bottom));
    border-top: 1px solid var(--gris-200);
    display: flex;
    flex-direction: column;
    gap: var(--e-3);
    background: var(--papel);
  }
  .mini__linea { display: flex; justify-content: space-between; align-items: baseline; font-size: 0.9375rem; }
  .mini__linea b { font-size: var(--t-precio); }
  .mini__nota { font-size: var(--t-meta); color: var(--gris-texto); }

  /* ---- Línea de producto ---- */
  :global(.mini-item) {
    display: flex;
    gap: var(--e-3);
    padding-bottom: var(--e-4);
    margin-bottom: var(--e-4);
    border-bottom: 1px solid var(--gris-200);
  }
  :global(.mini-item:last-child) { border-bottom: 0; margin-bottom: 0; }
  :global(.mini-item__foto) {
    flex: none;
    width: 68px; height: 85px;
    object-fit: cover;
    border-radius: var(--r-tarjeta);
    background: var(--gris-050);
  }
  :global(.mini-item__datos) { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--e-1); }
  :global(.mini-item__nombre) {
    font-size: 0.875rem; font-weight: 500; line-height: 1.35;
    display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  :global(.mini-item__nombre a) { color: var(--tinta); text-decoration: none; }
  :global(.mini-item__variante) { font-size: var(--t-meta); color: var(--gris-texto); }
  :global(.mini-item__pie) { display: flex; align-items: center; justify-content: space-between; gap: var(--e-2); margin-top: auto; }
  :global(.mini-item__precio) { font-weight: 700; font-variant-numeric: tabular-nums; }
  :global(.mini-item__quitar) {
    background: none; border: 0; padding: 0;
    font-size: var(--t-meta);
    color: var(--gris-texto);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  :global(.mini-item__quitar:hover) { color: var(--rojo); }
</style>
