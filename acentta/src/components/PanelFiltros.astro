---
/**
 * Filtros del listado.
 * ---------------------------------------------------------------
 * En escritorio es una columna al costado, siempre visible: esconder
 * los filtros detrás de un botón cuesta uso.
 * En móvil es un panel a pantalla completa, porque un desplegable de
 * filtros dentro de una pantalla de 390 px no deja ver el resultado
 * de lo que se está eligiendo.
 *
 * Todas las opciones se generan del catálogo. Si un color no existe
 * en esta categoría, no aparece — un filtro que devuelve cero
 * resultados siempre es un filtro mal armado.
 */
import { precio as fPrecio } from '@lib/formato';
import { NOMBRE_CATEGORIA, type OpcionColor } from '@lib/catalogo';
import type { Categoria } from '@tipos/catalogo';

interface Props {
  colores: OpcionColor[];
  categorias: { clave: Categoria; cantidad: number }[];
  rango: { min: number; max: number };
  /** Cuántos productos hay en total antes de filtrar. */
  total: number;
  /** Oculta el filtro de categoría (en una página de categoría no aporta). */
  sinCategoria?: boolean;
}

const { colores, categorias, rango, total, sinCategoria = false } = Astro.props;

/* Tramos de precio calculados sobre el rango real del conjunto.
   Un tramo fijo de "hasta $10.000" en un catálogo que arranca en
   $15.000 es una opción que no sirve para nada. */
const paso = Math.ceil((rango.max - rango.min) / 3 / 5000) * 5000;
const tramos = [
  { id: 'p1', etiqueta: `Hasta ${fPrecio(rango.min + paso)}`, min: 0, max: rango.min + paso },
  { id: 'p2', etiqueta: `${fPrecio(rango.min + paso)} a ${fPrecio(rango.min + paso * 2)}`, min: rango.min + paso, max: rango.min + paso * 2 },
  { id: 'p3', etiqueta: `Más de ${fPrecio(rango.min + paso * 2)}`, min: rango.min + paso * 2, max: Infinity },
];
---

<aside class="filtros" id="filtros" aria-labelledby="tit-filtros">
  <div class="filtros__cabeza">
    <h2 class="filtros__titulo" id="tit-filtros">Filtrar</h2>
    <button class="filtros__cerrar" type="button" data-cerrar-filtros aria-label="Cerrar filtros">
      <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M5 5l10 10M15 5L5 15" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <div class="filtros__cuerpo">
    <!-- Disponibilidad primero: es el que más resultados descarta -->
    <fieldset class="grupo">
      <legend class="grupo__titulo">Disponibilidad</legend>
      <label class="opcion">
        <input type="checkbox" data-filtro="disponible" value="true" />
        <span class="opcion__marca" aria-hidden="true"></span>
        <span class="opcion__texto">Sólo con stock</span>
      </label>
      <label class="opcion">
        <input type="checkbox" data-filtro="oferta" value="true" />
        <span class="opcion__marca" aria-hidden="true"></span>
        <span class="opcion__texto">Sólo en oferta</span>
      </label>
    </fieldset>

    <fieldset class="grupo">
      <legend class="grupo__titulo">Precio</legend>
      {tramos.map((t) => (
        <label class="opcion">
          <input type="checkbox" data-filtro="precio" value={`${t.min}-${t.max}`} />
          <span class="opcion__marca" aria-hidden="true"></span>
          <span class="opcion__texto tabular">{t.etiqueta}</span>
        </label>
      ))}
    </fieldset>

    {!sinCategoria && categorias.length > 1 && (
      <fieldset class="grupo">
        <legend class="grupo__titulo">Categoría</legend>
        {categorias.map((c) => (
          <label class="opcion">
            <input type="checkbox" data-filtro="categoria" value={c.clave} />
            <span class="opcion__marca" aria-hidden="true"></span>
            <span class="opcion__texto">{NOMBRE_CATEGORIA[c.clave]}</span>
            <span class="opcion__cuenta tabular">{c.cantidad}</span>
          </label>
        ))}
      </fieldset>
    )}

    {colores.length > 0 && (
      <fieldset class="grupo">
        <legend class="grupo__titulo">Color</legend>
        <div class="colores">
          {colores.map((c) => (
            <label class="color">
              <input type="checkbox" data-filtro="color" value={c.nombre} />
              <span class="color__muestra" style={`--muestra:${c.muestra}`} aria-hidden="true"></span>
              <span class="color__nombre">{c.nombre}</span>
            </label>
          ))}
        </div>
        <p class="grupo__nota">Sólo se listan los colores con stock.</p>
      </fieldset>
    )}
  </div>

  <div class="filtros__pie">
    <button class="boton boton--secundario" type="button" data-limpiar-filtros>
      <span class="boton__texto">Limpiar</span>
    </button>
    <button class="boton boton--primario" type="button" data-cerrar-filtros>
      <span class="boton__texto">Ver <span data-cuenta-boton>{total}</span> productos</span>
    </button>
  </div>
</aside>

<style>
  .filtros {
    display: flex;
    flex-direction: column;
    background: var(--papel);
    border: 1px solid var(--gris-200);
    border-radius: var(--r-modal);
  }

  .filtros__cabeza {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--e-4) var(--e-5);
    border-bottom: 1px solid var(--gris-200);
  }
  .filtros__titulo { font-size: 1rem; font-weight: 700; }
  .filtros__cerrar {
    display: none;
    width: 40px; height: 40px;
    align-items: center; justify-content: center;
    background: none; border: 0; cursor: pointer; color: var(--tinta);
    border-radius: var(--r-tarjeta);
  }
  .filtros__cerrar:hover { background: var(--gris-050); }

  .filtros__cuerpo { padding: var(--e-2) var(--e-5); overflow-y: auto; flex: 1; }

  .grupo { border: 0; padding: var(--e-4) 0; margin: 0; border-bottom: 1px solid var(--gris-200); }
  .grupo:last-child { border-bottom: 0; }
  .grupo__titulo {
    font-size: var(--t-meta);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .07em;
    color: var(--gris-texto);
    padding: 0;
    margin-bottom: var(--e-3);
  }
  .grupo__nota { margin-top: var(--e-3); font-size: var(--t-meta); color: var(--gris-texto); }

  /* ---- Casilla ---- */
  .opcion {
    display: flex;
    align-items: center;
    gap: var(--e-3);
    min-height: 40px;
    cursor: pointer;
    font-size: 0.9375rem;
  }
  .opcion input { position: absolute; opacity: 0; width: 0; height: 0; }
  .opcion__marca {
    flex: none;
    width: 20px; height: 20px;
    border: 1.5px solid var(--gris-500);
    border-radius: var(--r-badge);
    background: var(--papel);
    display: grid;
    place-items: center;
    transition: background-color var(--v-rapido) var(--curva), border-color var(--v-rapido) var(--curva);
  }
  .opcion__marca::after {
    content: '';
    width: 11px; height: 6px;
    border-left: 2px solid var(--papel);
    border-bottom: 2px solid var(--papel);
    transform: rotate(-45deg) translate(1px, -1px);
    opacity: 0;
  }
  .opcion:hover .opcion__marca { border-color: var(--tinta); }
  .opcion input:checked + .opcion__marca { background: var(--verde); border-color: var(--verde); }
  .opcion input:checked + .opcion__marca::after { opacity: 1; }
  .opcion input:focus-visible + .opcion__marca {
    outline: 3px solid var(--foco-color);
    outline-offset: 2px;
  }
  .opcion__texto { flex: 1; }
  .opcion__cuenta { color: var(--gris-texto); font-size: var(--t-meta); }

  /* ---- Color ---- */
  .colores { display: flex; flex-direction: column; gap: var(--e-1); }
  .color {
    display: flex;
    align-items: center;
    gap: var(--e-3);
    min-height: 40px;
    cursor: pointer;
    font-size: 0.9375rem;
  }
  .color input { position: absolute; opacity: 0; width: 0; height: 0; }
  .color__muestra {
    flex: none;
    width: 24px; height: 24px;
    border-radius: 50%;
    background: var(--muestra);
    box-shadow: inset 0 0 0 1px rgba(28, 24, 20, .18);
    transition: box-shadow var(--v-rapido) var(--curva);
  }
  .color input:checked + .color__muestra {
    box-shadow: inset 0 0 0 1px rgba(28, 24, 20, .18), 0 0 0 2px var(--papel), 0 0 0 4px var(--verde);
  }
  .color input:focus-visible + .color__muestra {
    outline: 3px solid var(--foco-color);
    outline-offset: 3px;
  }
  .color input:checked ~ .color__nombre { font-weight: 600; }

  .filtros__pie {
    display: none;
    gap: var(--e-3);
    padding: var(--e-4) var(--e-5);
    border-top: 1px solid var(--gris-200);
    background: var(--papel);
  }
  .filtros__pie .boton { flex: 1; }

  /* ============================================================
     Móvil: pantalla completa
     ============================================================ */
  @media (max-width: 899px) {
    .filtros {
      position: fixed;
      inset: 0;
      z-index: 60;
      border: 0;
      border-radius: 0;
      transform: translateY(100%);
      visibility: hidden;
      transition: transform var(--v-medio) var(--curva), visibility var(--v-medio);
    }
    .filtros[data-abierto='true'] { transform: translateY(0); visibility: visible; }
    .filtros__cerrar { display: flex; }
    .filtros__pie { display: flex; }
  }
</style>
