---
/**
 * Pie del sitio.
 * Todo lo que reduce riesgo percibido vive acá arriba y no escondido:
 * una tienda sin reputación se juega la venta en esto.
 * El botón de arrepentimiento y el enlace a Defensa del Consumidor son
 * exigibles por ley en Argentina (Resolución 424/2020).
 */
import Logo from '@componentes/Logo.astro';

const comprar = [
  { nombre: 'Iluminación', href: '/categoria/iluminacion' },
  { nombre: 'Textil', href: '/categoria/textil' },
  { nombre: 'Alfombras', href: '/categoria/alfombras' },
  { nombre: 'Muebles chicos', href: '/categoria/muebles-chicos' },
  { nombre: 'Ofertas', href: '/ofertas' },
];

const ayuda = [
  { nombre: 'Envíos y plazos', href: '/envios' },
  { nombre: 'Cambios y devoluciones', href: '/devoluciones' },
  { nombre: 'Seguimiento de pedido', href: '/seguimiento' },
  { nombre: 'Preguntas frecuentes', href: '/ayuda' },
  { nombre: 'Contacto', href: '/contacto' },
];

/* Los medios de pago se dibujan con el logo de cada marca si el
   archivo está, y con el nombre en texto si no.
   ---------------------------------------------------------------
   No están puestos a mano en el marcado a propósito: son marcas
   registradas y los archivos oficiales los tiene que bajar cada
   marca de su propio sitio. Dibujarlos de memoria saldría mal —una
   marca mal dibujada se nota— y además imitar una marca registrada
   es otro problema distinto.

   Entonces: se lee la carpeta al compilar. El día que aparezca
   `public/medios/visa.svg`, el logo se muestra solo. Hasta entonces
   queda el nombre en texto, que informa lo mismo aunque luzca menos.
   Nadie tiene que tocar este archivo para agregar uno. */
const ARCHIVOS = import.meta.glob('/public/medios/*.{svg,png}', { eager: true, query: '?url', import: 'default' });

/* El logo del estudio va en línea y no como <img>: así hereda el
   color del texto que lo rodea —el archivo trae `currentColor`— y no
   suma una petición más para un dibujo de dos kilobytes. */
const logoEstudio = (
  await import('../../public/blanco-activo-studio.svg?raw')
).default as string;

const medios = [
  { nombre: 'Visa', clave: 'visa' },
  { nombre: 'Mastercard', clave: 'mastercard' },
  { nombre: 'American Express', clave: 'amex' },
  { nombre: 'Cabal', clave: 'cabal' },
  { nombre: 'Mercado Pago', clave: 'mercadopago' },
  { nombre: 'Transferencia', clave: 'transferencia' },
].map((m) => {
  const encontrado = Object.keys(ARCHIVOS).find((ruta) => {
    const nombre = ruta.split('/').pop()!.replace(/\.(svg|png)$/, '').toLowerCase();
    return nombre === m.clave;
  });
  return { ...m, logo: encontrado ? encontrado.replace('/public', '') : null };
});
---

<footer class="pie">
  <div class="contenedor">
    <div class="pie__rejilla">
      <div class="pie__marca">
        <Logo alto={40} />
        <p class="pie__lema">
          Decoración e iluminación para la casa, con envío a todo el país.
        </p>
        <div class="pie__contacto">
          <p><b>hola@acentta.com.ar</b></p>
          <p>Respondemos dentro de las 24 h hábiles.</p>
          <p>Lunes a viernes de 9 a 18 h · Córdoba, Argentina</p>
        </div>
      </div>

      <nav class="pie__grupo" aria-labelledby="pie-comprar">
        <h2 class="pie__titulo" id="pie-comprar">Comprar</h2>
        <ul>
          {comprar.map((e) => <li><a href={e.href}>{e.nombre}</a></li>)}
        </ul>
      </nav>

      <nav class="pie__grupo" aria-labelledby="pie-ayuda">
        <h2 class="pie__titulo" id="pie-ayuda">Ayuda</h2>
        <ul>
          {ayuda.map((e) => <li><a href={e.href}>{e.nombre}</a></li>)}
        </ul>
      </nav>

      <div class="pie__grupo">
        <h2 class="pie__titulo">Comprar sin riesgo</h2>
        <ul class="pie__garantias">
          <li>
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M6.2 11.4 3.3 8.5l-1.1 1.1 4 4 7.6-7.6-1.1-1.1z"/></svg>
            30 días para devolverlo, sin explicar por qué
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M6.2 11.4 3.3 8.5l-1.1 1.1 4 4 7.6-7.6-1.1-1.1z"/></svg>
            El costo de la devolución lo pagamos nosotros
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M6.2 11.4 3.3 8.5l-1.1 1.1 4 4 7.6-7.6-1.1-1.1z"/></svg>
            Compra protegida: si no llega, te devolvemos el dinero
          </li>
        </ul>
      </div>
    </div>

    <div class="pie__medios">
      <p class="pie__titulo">Medios de pago</p>
      <ul class="pie__fichas">
        {medios.map((m) => (
          <li class={m.logo ? 'pie__ficha pie__ficha--logo' : 'pie__ficha'}>
            {m.logo
              ? <img src={m.logo} alt={m.nombre} width="38" height="24" loading="lazy" decoding="async" />
              : m.nombre}
          </li>
        ))}
      </ul>
      <p class="pie__nota">Hasta 12 cuotas sin interés con bancos seleccionados.</p>
    </div>

    <div class="pie__legal">
      <!-- El crédito del estudio va acá, junto al de la marca. En un
           pie de tienda, quien la hizo va abajo y en chico: el
           protagonista es el negocio. Pero va, porque una tienda que
           funciona es la mejor carta de presentación que hay. -->
      <p class="pie__estudio">
        <span>Diseño y desarrollo</span>
        <a href="/caso" aria-label="BLANCO ACTIVO studio">
          <Fragment set:html={logoEstudio} />
        </a>
      </p>

      <p class="pie__copia">
        © 2026 acentta · Proyecto conceptual de portafolio. No es una tienda real
        y no procesa pagos.
        <!-- El enlace al caso de estudio va acá, junto a la aclaración de
             que esto es un portafolio: es donde alguien que se dio cuenta
             de que no es una tienda de verdad va a buscar la explicación. -->
        <a class="pie__caso" href="/caso">Ver cómo se construyó</a>
      </p>
      <ul class="pie__enlaces-legales">
        <li><a href="/terminos">Términos y condiciones</a></li>
        <li><a href="/privacidad">Política de privacidad</a></li>
        <li><a class="pie__arrepentimiento" href="/arrepentimiento">Botón de arrepentimiento</a></li>
        <li><a href="https://autogestion.produccion.gob.ar/consumidores" rel="noopener">Defensa de las y los Consumidores</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .pie {
    margin-top: var(--e-24);
    padding-block: var(--e-16) var(--e-8);
    background: var(--gris-050);
    border-top: 1px solid var(--gris-200);
    font-size: 0.875rem;
  }

  .pie__rejilla {
    display: grid;
    gap: var(--e-10);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .pie__rejilla { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .pie__rejilla { grid-template-columns: 1.4fr 1fr 1fr 1.2fr; gap: var(--e-8); } }

  .pie__lema { margin: var(--e-4) 0; color: var(--gris-800); max-width: 34ch; }
  .pie__contacto { display: flex; flex-direction: column; gap: 2px; color: var(--gris-texto); font-size: var(--t-meta); }
  .pie__contacto b { color: var(--tinta); font-size: 0.875rem; }

  .pie__titulo {
    font-size: var(--t-meta);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .07em;
    color: var(--tinta);
    margin-bottom: var(--e-4);
  }

  .pie__grupo ul { list-style: none; display: flex; flex-direction: column; gap: var(--e-3); }
  .pie__grupo a { color: var(--gris-800); text-decoration: none; }
  .pie__grupo a:hover { color: var(--tinta); text-decoration: underline; text-underline-offset: 3px; }

  .pie__garantias li {
    display: flex;
    gap: var(--e-2);
    align-items: flex-start;
    color: var(--gris-800);
    line-height: 1.45;
  }
  .pie__garantias svg { flex: none; margin-top: 2px; color: var(--verde); }

  .pie__medios {
    margin-top: var(--e-12);
    padding-top: var(--e-8);
    border-top: 1px solid var(--gris-200);
  }
  .pie__fichas { display: flex; flex-wrap: wrap; gap: var(--e-2); list-style: none; }
  .pie__ficha {
    padding: var(--e-2) var(--e-3);
    background: var(--papel);
    border: 1px solid var(--gris-200);
    border-radius: var(--r-badge);
    font-size: var(--t-meta);
    font-weight: 600;
    color: var(--gris-800);
  }
  .pie__nota { margin-top: var(--e-3); color: var(--gris-texto); font-size: var(--t-meta); }

  .pie__caso {
    display: inline-block;
    margin-left: var(--e-1);
    color: var(--naranja-texto);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pie__legal {
    margin-top: var(--e-10);
    padding-top: var(--e-6);
    border-top: 1px solid var(--gris-200);
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-4);
    justify-content: space-between;
    align-items: center;
  }
  .pie__ficha--logo {
    padding: 6px var(--e-2);
    display: inline-flex; align-items: center;
  }
  .pie__ficha--logo img { height: 22px; width: auto; display: block; }

  .pie__estudio {
    display: flex; align-items: center; gap: var(--e-3);
    color: var(--gris-texto); font-size: var(--t-meta);
  }
  .pie__estudio a {
    display: inline-flex; align-items: center;
    color: var(--gris-800);
    transition: color var(--v-rapido) var(--curva);
  }
  .pie__estudio a:hover { color: var(--tinta); }
  /* El alto manda y el ancho se calcula solo: el archivo del logo es
     apaisado y fijarle los dos lados lo deformaría. */
  .pie__estudio :global(svg) { height: 17px; width: auto; display: block; }

  .pie__copia { color: var(--gris-texto); font-size: var(--t-meta); max-width: 52ch; }
  .pie__enlaces-legales { display: flex; flex-wrap: wrap; gap: var(--e-4); list-style: none; }
  .pie__enlaces-legales a { color: var(--gris-800); font-size: var(--t-meta); text-decoration: underline; text-underline-offset: 3px; }
  .pie__enlaces-legales a:hover { color: var(--tinta); }
  .pie__arrepentimiento { font-weight: 600; }
</style>
