---
/**
 * Botón de WhatsApp.
 * ---------------------------------------------------------------
 * El diseño viene del proyecto SIDAMO: círculo de 60 px, verde de
 * marca, halo que pulsa, y la sombra y el rebote al pasar por
 * encima. Se mantiene igual a propósito — es la continuidad visual
 * del estudio, y un botón que en cada trabajo se ve distinto deja de
 * ser una firma.
 *
 * Lo que se le suma es lo que esta tienda necesita y aquel sitio no
 * tenía por qué tener: contexto en el mensaje, ausencia en el
 * circuito de cobro, y no taparle la barra de comprar a la ficha.
 *
 * POR QUÉ NO UN CHAT EN VIVO
 *
 * Un chat en pantalla promete respuesta inmediata. Si del otro lado
 * no hay nadie sentado esperando, esa promesa se rompe delante del
 * cliente y queda peor que no haberla hecho. WhatsApp es asincrónico
 * por naturaleza: nadie se ofende porque tardes veinte minutos.
 */
interface Props {
  /** Sobre qué se consulta. Si falta, va un saludo genérico. */
  producto?: string;
}
const { producto } = Astro.props;

/* El número, en un solo lugar. Con código de país y sin signos: es
   como lo espera la dirección de WhatsApp. */
const NUMERO = '5493516205995';

/* El mensaje va precargado con contexto. Sin eso la conversación
   empieza con «hola» y sigue con «¿por cuál producto?», que es una
   vuelta perdida para las dos partes y donde más gente abandona. */
const mensaje = producto
  ? `Hola acentta, consulto por ${producto} que vi en la web.`
  : 'Hola acentta, quiero hacer una consulta.';

const enlace = `https://wa.me/${NUMERO}?text=${encodeURIComponent(mensaje)}`;
---

<!-- Envuelto en un <aside> con nombre, y no suelto en el cuerpo.
     Quien recorre una página saltando entre puntos de referencia —que
     es como navega mucha gente con lector de pantalla— no encuentra
     lo que está fuera de todos ellos. Un botón flotante suelto es
     contenido huérfano: se puede tabular hasta él, pero no aparece en
     el índice de regiones. Es el mismo caso que tuvo la franja de
     promesas del encabezado.
     El <aside> no cambia nada de lo que se ve. -->
<aside class="wa-caja" aria-label="Consultas por WhatsApp">
  <a
    class="wa-float"
    href={enlace}
    target="_blank"
    rel="noopener"
    aria-label={producto ? `Consultar por ${producto} por WhatsApp` : 'Escribinos por WhatsApp'}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2A10 10 0 0 0 2 12c0 1.77.46 3.43 1.27 4.87L2 22l5.25-1.38A9.96 9.96 0 0 0 12 22a10 10 0 0 0 0-20zm0 18.3c-1.6 0-3.1-.43-4.4-1.18l-.32-.19-3.12.82.83-3.04-.2-.32A8.28 8.28 0 0 1 3.7 12 8.3 8.3 0 1 1 12 20.3zm4.55-6.15c-.25-.13-1.47-.72-1.7-.8-.23-.09-.4-.13-.56.12-.17.25-.64.8-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.38-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.14-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.16 0-.43.06-.65.31-.22.25-.86.85-.86 2.06 0 1.21.88 2.38 1 2.55.13.17 1.74 2.66 4.22 3.73.59.25 1.05.4 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29z"/></svg>
  </a>
</aside>

<style>
  /* La posición vive en el contenedor y el aspecto en el enlace. En
     el original iban juntos; separarlos es lo que permite subir el
     botón en la ficha sin tocar nada de su forma. */
  .wa-caja {
    position: fixed;
    right: 24px;
    /* Se apoya en el borde de seguridad del teléfono: en los que
       tienen barra de gestos, una posición fija al ras queda debajo
       de ella y se toca sin querer al volver al inicio. */
    bottom: max(24px, env(safe-area-inset-bottom));
    /* Debajo del mini-carrito y del panel de filtros, que son 70 y
       60. Un botón de consulta por encima de un panel abierto es un
       botón que aparece donde no lo llamaron. */
    z-index: 45;
  }

  .wa-float {
    position: relative;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #25D366;
    box-shadow: 0 10px 28px -6px rgba(0, 0, 0, .55);
    transition: transform .3s cubic-bezier(.2, .8, .2, 1), box-shadow .3s;
  }

  /* El halo. Va detrás del círculo y crece hasta desaparecer. */
  .wa-float::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #25D366;
    z-index: -1;
    animation: waPulse 2.4s ease-out infinite;
  }

  .wa-float:hover {
    transform: scale(1.08) translateY(-2px);
    box-shadow: 0 16px 36px -8px rgba(37, 211, 102, .7);
  }
  .wa-float:focus-visible { outline: 3px solid var(--foco-color); outline-offset: 4px; }

  /* Glifo blanco sobre el verde: es el logotipo de WhatsApp tal como
     lo define su marca, y los logotipos quedan fuera del mínimo de
     contraste —tanto en 1.4.3 como en 1.4.11—. En la primera versión
     lo había oscurecido para «cumplir», y era aplicar la regla donde
     no corresponde: el resultado era un WhatsApp que no parecía
     WhatsApp. Quien no distinga el ícono tiene el nombre accesible
     del enlace, que es lo que la regla sí exige. */
  .wa-float svg { width: 34px; height: 34px; fill: #fff; }

  @keyframes waPulse {
    0%   { transform: scale(1); opacity: .6; }
    70%  { transform: scale(1.5); opacity: 0; }
    100% { opacity: 0; }
  }

  /* En la ficha de producto hay una barra fija abajo con el precio y
     el botón de agregar. El de WhatsApp sube para no taparla: un
     botón de consulta encima del botón de comprar es exactamente al
     revés de lo que conviene. */
  :global(body:has(.barra-movil[data-visible='true'])) .wa-caja {
    bottom: calc(max(24px, env(safe-area-inset-bottom)) + 76px);
  }

  @media (max-width: 520px) {
    .wa-caja { right: 16px; bottom: max(16px, env(safe-area-inset-bottom)); }
    .wa-float { width: 54px; height: 54px; }
    .wa-float svg { width: 30px; height: 30px; }
    :global(body:has(.barra-movil[data-visible='true'])) .wa-caja {
      bottom: calc(max(16px, env(safe-area-inset-bottom)) + 76px);
    }
  }

  /* Un latido permanente en un rincón de la pantalla es agotador para
     quien tiene sensibilidad al movimiento, y en algunos casos
     dispara síntomas. Se apaga el halo y el rebote; el botón queda
     igual de usable. */
  @media (prefers-reduced-motion: reduce) {
    .wa-float::before { animation: none; }
    .wa-float { transition: none; }
    .wa-float:hover { transform: none; }
  }
</style>
