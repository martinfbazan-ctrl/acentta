---
import '@estilos/fuentes.css';
import '@estilos/tokens.css';
import '@estilos/base.css';
import '@estilos/componentes.css';
import {
  fotoProporcion, srcsetProporcion,
  HERO_MOVIL, HERO_ESCRITORIO, CORTE_HERO,
} from '@lib/imagenes';
import MiniCarrito from '@componentes/MiniCarrito.astro';
import BotonWhatsApp from '@componentes/BotonWhatsApp.astro';

interface Props {
  titulo: string;
  descripcion: string;
  /** Deja la página fuera del índice de buscadores. */
  sinIndexar?: boolean;
  /** Datos estructurados de la página. Van en el head, que es donde
   *  corresponde: colgados después de </html> el HTML deja de validar. */
  esquema?: unknown;
  /** Apaga el botón de consulta. Se usa en el circuito de cobro. */
  sinBotonConsulta?: boolean;
  /** Nombre del producto, para que la consulta llegue con contexto. */
  productoConsulta?: string;
  /**
   * Imagen que hay que precargar porque es el LCP de la página.
   * Solo la home la usa: en el resto el elemento más grande es texto.
   */
  precargarImagen?: string;
}

const {
  titulo, descripcion, sinIndexar = false, esquema,
  sinBotonConsulta = false, productoConsulta, precargarImagen,
} = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
const portada = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />

    {/* Un `preload` por recorte, con el mismo `media` que los `<source>`
        del hero: el navegador baja solo el que corresponde a su pantalla.
        Los `imagesrcset` e `imagesizes` repiten los del `<picture>` para
        que elija exactamente el mismo archivo y no descargue dos. */}
    {precargarImagen && (
      <>
        <link
          rel="preload"
          as="image"
          media={`(max-width: ${CORTE_HERO - 1}px)`}
          href={fotoProporcion(precargarImagen, 1200, HERO_MOVIL)}
          imagesrcset={srcsetProporcion(precargarImagen, HERO_MOVIL)}
          imagesizes="100vw"
          fetchpriority="high"
        />
        <link
          rel="preload"
          as="image"
          media={`(min-width: ${CORTE_HERO}px)`}
          href={fotoProporcion(precargarImagen, 1600, HERO_ESCRITORIO)}
          imagesrcset={srcsetProporcion(precargarImagen, HERO_ESCRITORIO)}
          imagesizes="100vw"
          fetchpriority="high"
        />
      </>
    )}
    {sinIndexar && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/*
      Conexión anticipada al proveedor de fotos.
      La imagen del hero es el LCP y vive en otro dominio: antes de
      poder pedirla hay que resolver el DNS, abrir el TCP y negociar
      el TLS. En una red móvil eso son varios cientos de milisegundos
      en los que no se descarga ni un byte. Con `preconnect` esa
      negociación arranca junto con el HTML, en paralelo.
      Cuando las fotos pasen a servirse desde el propio dominio, esta
      línea sobra y hay que borrarla: un preconnect a un dominio que
      no se usa es una conexión abierta al pedo.
    */}
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="dns-prefetch" href="https://images.unsplash.com" />

    {/* La fuente se precarga: es el recurso que bloquea el primer texto útil. */}
    <link
      rel="preload"
      href="/fuentes/inter-variable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="theme-color" content="#C8431A" />

    {/*
      La tarjeta que se ve cuando alguien pega el enlace en WhatsApp,
      LinkedIn o Slack. Sin `og:image` esas plataformas muestran un
      recuadro gris con la dirección — el peor primer contacto posible
      para una tienda que todavía no tiene reputación.

      La imagen es absoluta a propósito: los lectores de enlaces no
      resuelven rutas relativas, así que una ruta como "/og.png"
      simplemente no carga. Por eso se arma contra `site`, y por eso
      `site` tiene que apuntar al dominio real en astro.config.mjs.

      Las medidas van declaradas para que la tarjeta se reserve antes
      de que la imagen baje, y `og:image:alt` está por lo mismo que
      cualquier otro alt del sitio.
    */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="acentta" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={portada} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="acentta · Decoración e iluminación para tu casa" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={portada} />

    {esquema && (
      <script type="application/ld+json" set:html={JSON.stringify(esquema)} is:inline />
    )}
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <slot name="encabezado" />
    <main id="contenido">
      <slot />
    </main>
    <slot name="pie" />

    <MiniCarrito />

    {/*
      El botón de consulta va en todas las páginas menos las del
      cobro. En el carrito y en el checkout, un botón flotante que
      invita a irse a otra aplicación en el momento exacto en que
      alguien está por pagar es una salida de emergencia puesta al
      lado de la caja. Quien tiene una duda ahí, la tuvo antes.
      La consulta por producto viaja desde la ficha: `productoConsulta`.
    */}
    {!sinBotonConsulta && <BotonWhatsApp producto={productoConsulta} />}

    <script>
      import '../scripts/base';
      import '../scripts/marquesina';
      import '../scripts/carrito';
      import '../scripts/buscador';
    </script>
  </body>
</html>
